{
  "manifest_version": 3,
  "name": "submix",
  "version": "0.1.0",
  "description": "Netflix の字幕を行ごとに日本語 / 英語 / 非表示へ確率的に振り分けます。",
  "permissions": ["storage"],
  "host_permissions": ["https://*.netflix.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "submix"
  },
  "content_scripts": [
    {
      "matches": ["https://*.netflix.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.netflix.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
